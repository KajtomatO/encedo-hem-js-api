// implements: REQ-BUILD-001 — ESM output with declarations; package.json carries "type": "module" and the exports map
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "removeComments": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
