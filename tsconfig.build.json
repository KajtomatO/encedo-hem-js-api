{
  // Build: src/ only, emits ESM .js and .d.ts into dist/.
  // implements: REQ-BUILD-001
  // implements: REQ-BUILD-003 — no Node typings and only the DOM/ES libraries here,
  // so src/ cannot compile against Node-only APIs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2024", "DOM"],
    "types": [],
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"]
}
